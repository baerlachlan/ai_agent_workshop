linters: linters_with_defaults(
    line_length_linter(100),
    object_name_linter(styles = c("snake_case", "SNAKE_CASE")),
    object_usage_linter = NULL
  )
exclusions: list(
    "bottles.R",
    "tests" = list(
      semicolon_linter = Inf,
      brace_linter = Inf,
      indentation_linter = Inf,
      assignment_linter = Inf
    )
  )
encoding: "UTF-8"
